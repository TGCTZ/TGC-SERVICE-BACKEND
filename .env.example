# Django Settings

# Required; no default is configured.
SECRET_KEY=replace-me
DEBUG=True
# Required when DEBUG=False.
# Security Settings
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC
# Local date used for reporting.
LAB_TIME_ZONE=Africa/Dar_es_Salaam
# Valid levels: DEBUG, INFO, WARNING, ERROR, CRITICAL.
LOG_LEVEL=INFO

# Comma-separated allowed browser origins.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Database Configuration
# Tests use in-memory SQLite.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tgcservice

# Session Configuration
# Access-token lifetime; session controls may revoke tokens earlier.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# GePG API URLs
# Enable simulation only for local development.
GEPG_SIMULATE=False
# Bill automatically after the final stone is identified.
AUTO_BILL_AFTER_IDENTIFICATION=False
GEPG_BILL_CREATE_URL=
GEPG_BILL_CANCEL_URL=
GEPG_RECONCILIATION_URL=
# GePG Service Provider Configuration
GEPG_SP_GRP_CODE=
GEPG_SYS_CODE=
GEPG_SP_CODE=
GEPG_SUB_SP_CODE=
GEPG_COLL_CENT_CODE=
GEPG_GFS_CODE=
# GePG Signing Configuration
# Enable signing when the private PKCS#12 certificate is mounted.
GEPG_USE_DIGITAL_SIGNATURE=True
GEPG_CERTIFICATE_PASSWORD=
# Certificate paths default to certificates/private.pfx and public.pfx.
# GEPG_PRIVATE_KEY_PATH=
# GEPG_PUBLIC_CERT_PATH=
GEPG_BILL_EXPIRY_DAYS=365

# SMS Configuration
BEEM_AFRICA_API_KEY=
BEEM_AFRICA_SECRET_KEY=

# Certificate and Email Settings
# Lab contact details shown on certificates, verification pages, and emails.
CERTIFICATE_LAB_NAME=Tanzania Gemmological Centre
CERTIFICATE_LAB_ADDRESS=P.O. Box 119, Arusha, Tanzania
CERTIFICATE_MINISTRY_NAME=Ministry of Minerals
# Base URL for certificate QR codes.
CERTIFICATE_VERIFY_BASE_URL=http://localhost:8000

# Staff sign-in URL used in account emails.
FRONTEND_URL=http://localhost:5173
# SMTP URL, e.g. smtp+tls://user:password@host:587.
# When unset, email is written to the console.
# EMAIL_URL=
# DEFAULT_FROM_EMAIL=Tanzania Gemmological Centre <no-reply@tgc.go.tz>
