# Copy to .env. Every key is read in config/settings/base.py.

# --- Core ---
# No fallback in settings; the app will not start without it.
SECRET_KEY=replace-me
DEBUG=True
# Required once DEBUG is False.
ALLOWED_HOSTS=localhost,127.0.0.1
TIME_ZONE=UTC
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Comma-separated browser origins. Ignored while DEBUG is True.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Database ---
# Tests ignore this and use in-memory SQLite.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/djangoapitemplate

# --- Authentication ---
# Access tokens cannot be revoked before they expire.
JWT_ACCESS_MINUTES=60
JWT_REFRESH_DAYS=14

# --- GePG payment gateway ---
# Leave the URLs blank and set GEPG_SIMULATE=True to work offline.
GEPG_SIMULATE=True
GEPG_BILL_CREATE_URL=
GEPG_BILL_CANCEL_URL=
GEPG_RECONCILIATION_URL=
GEPG_SP_GRP_CODE=
GEPG_SYS_CODE=
GEPG_SP_CODE=
GEPG_SUB_SP_CODE=
GEPG_COLL_CENT_CODE=
GEPG_GFS_CODE=
# Signing is off until a PKCS#12 key is dropped into certificates/.
GEPG_USE_DIGITAL_SIGNATURE=False
GEPG_CERTIFICATE_PASSWORD=
GEPG_BILL_EXPIRY_DAYS=365

# Printed in the header and signature block of every certificate PDF.
CERTIFICATE_LAB_NAME=Tanzania Gemmological Centre
CERTIFICATE_LAB_ADDRESS=P.O. Box 119, Arusha, Tanzania
CERTIFICATE_MINISTRY_NAME=Ministry of Minerals
# Absolute base for the QR link printed on certificates.
CERTIFICATE_VERIFY_BASE_URL=http://localhost:8000

# Staff sign-in page; linked from the new-account email.
FRONTEND_URL=http://localhost:5173
# Outgoing mail as a URL, e.g. smtp+tls://user:password@smtp.example.com:587
# Left unset, mail is printed to the server console.
# EMAIL_URL=
# DEFAULT_FROM_EMAIL=Tanzania Gemmological Centre <no-reply@tgc.go.tz>
