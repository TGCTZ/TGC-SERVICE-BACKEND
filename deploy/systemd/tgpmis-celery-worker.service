[Unit]
Description=TGPMIS GePG Celery worker
After=network-online.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=madini01
Group=madini01
WorkingDirectory=/home/madini01/tgpmis-backend-production
Environment=DJANGO_SETTINGS_MODULE=config.settings.production
ExecStart=/home/madini01/.local/bin/uv run --frozen celery -A config.celery:app worker --loglevel=INFO --concurrency=2
Restart=always
RestartSec=5
TimeoutStopSec=60
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
